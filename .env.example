# Copy to .env and fill in. Never commit real values.
# Server-only Stripe secret TEST key (from https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_replace_me
# Password for the Reception dashboard at /reception
RECEPTION_PASSWORD=choose-a-strong-password
# Optional: public site URL used for Stripe redirect URLs (defaults to http://localhost:8080)
# PUBLIC_SITE_URL=http://localhost:8080
# Optional: folder for data/appointments.json (defaults to ./data)
# DATA_DIR=./data
